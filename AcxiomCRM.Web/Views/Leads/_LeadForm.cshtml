@model AcxiomCRM.Web.Models.Lead
<form method="post" class="content-card" novalidate><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input type="hidden" asp-for="LeadId" /><input type="hidden" asp-for="ConvertedCustomerId" />
<div class="row g-3">
<div class="col-md-3"><label asp-for="LeadCode" class="form-label"></label><input asp-for="LeadCode" class="form-control" /><span asp-validation-for="LeadCode" class="text-danger"></span></div>
<div class="col-md-5"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" class="form-control" /><span asp-validation-for="LeadName" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" class="form-control" /><span asp-validation-for="ExpectedValue" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Source" class="form-label"></label><input asp-for="Source" class="form-control" /></div>
<div class="col-md-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option>High</option><option>Medium</option><option>Low</option></select></div>
<div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select><span asp-validation-for="Status" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="AssignedToId" class="form-label">Assigned owner</label><select asp-for="AssignedToId" asp-items="ViewBag.Owners" class="form-select"></select><span asp-validation-for="AssignedToId" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
</div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
