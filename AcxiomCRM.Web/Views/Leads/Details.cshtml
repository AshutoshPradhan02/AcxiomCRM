@model AcxiomCRM.Web.Models.Lead
@{ ViewData["Title"] = "Lead Details"; }
<div class="page-heading"><div><h1>@Model.LeadName</h1><p class="text-muted">@Model.LeadCode</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.LeadId">Edit</a><form asp-action="Convert" asp-route-id="@Model.LeadId" method="post"><button class="btn btn-primary">Convert Qualified Lead</button></form></div></div>
<div class="content-card"><dl class="row"><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.Email @Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd><dt class="col-sm-3">Expected Value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("C0")</dd><dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@Model.AssignedTo?.FullName</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl></div>
