@model IEnumerable<AcxiomCRM.Web.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}
<div class="page-heading">
    <div><h1>Customers</h1><p class="text-muted">Search, filter, and manage customer records.</p></div>
    <a class="btn btn-primary" asp-action="Create">New Customer</a>
</div>
<div class="content-card">
    <form class="row g-2 mb-3" method="get">
        <div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search name, email, phone, company" /></div>
        <div class="col-md-3"><select class="form-select" name="status"><option value="">All statuses</option><option selected="@(ViewBag.Status == "Active")">Active</option><option selected="@(ViewBag.Status == "Inactive")">Inactive</option></select></div>
        <div class="col-md-2"><select class="form-select" name="sort"><option value="name">Name</option><option value="company" selected="@(ViewBag.Sort == "company")">Company</option><option value="created" selected="@(ViewBag.Sort == "created")">Created</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </form>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Code</th><th>Name</th><th>Contact</th><th>Company</th><th>Status</th><th>Owner</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerCode</td>
                    <td>@item.CustomerName</td>
                    <td>@item.Email<br /><span class="text-muted">@item.Phone</span></td>
                    <td>@item.CompanyName</td>
                    <td><span class="badge badge-soft">@item.Status</span></td>
                    <td>@item.AssignedTo?.FullName</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.CustomerId">Details</a>
                        <a class="ms-2" asp-action="Edit" asp-route-id="@item.CustomerId">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this customer?');"><button class="btn btn-link btn-sm text-danger">Deactivate</button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any()) { <div class="empty-state">No customers match the current filters.</div> }
</div>
