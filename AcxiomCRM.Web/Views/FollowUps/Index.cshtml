@model IEnumerable<AcxiomCRM.Web.Models.FollowUp>
@{ ViewData["Title"] = "Follow-ups"; }
<div class="page-heading"><div><h1>Follow-ups</h1><p class="text-muted">Upcoming, overdue, completed, and rescheduled actions.</p></div><a class="btn btn-primary" asp-action="Create">Schedule Follow-up</a></div>
<div class="content-card"><table class="table"><thead><tr><th>Date</th><th>Subject</th><th>Type</th><th>Related</th><th>Status</th><th>Owner</th><th></th></tr></thead><tbody>@foreach(var f in Model){<tr><td>@f.FollowUpDate.ToString("g")</td><td>@f.Subject</td><td>@f.FollowUpType</td><td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? f.Opportunity?.OpportunityName)</td><td>@f.Status</td><td>@f.AssignedTo?.FullName</td><td><form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-primary">Complete</button></form><form asp-action="Reschedule" asp-route-id="@f.FollowUpId" method="post" class="d-inline ms-2"><input name="followUpDate" type="datetime-local" /><button class="btn btn-sm btn-outline-secondary">Reschedule</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty-state">No follow-ups found.</div>}</div>
