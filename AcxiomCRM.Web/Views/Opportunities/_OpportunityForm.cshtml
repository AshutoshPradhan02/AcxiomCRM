@model AcxiomCRM.Web.Models.Opportunity
<form method="post" class="content-card" novalidate><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input type="hidden" asp-for="OpportunityId" /><input type="hidden" asp-for="LeadId" />
<div class="row g-3">
<div class="col-md-6"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control" /><span asp-validation-for="OpportunityName" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"></select><span asp-validation-for="CustomerId" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" /><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" /><span asp-validation-for="Probability" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="AssignedToId" class="form-label">Owner</label><select asp-for="AssignedToId" asp-items="ViewBag.Owners" class="form-select"></select><span asp-validation-for="AssignedToId" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" asp-items="ViewBag.Stages" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select></div>
<div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
</div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
