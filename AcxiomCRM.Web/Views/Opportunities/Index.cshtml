@model IEnumerable<AcxiomCRM.Web.Models.Opportunity>
@{ ViewData["Title"] = "Opportunities"; }
<div class="page-heading"><div><h1>Opportunities</h1><p class="text-muted">Pipeline value, probability, and outcomes.</p></div><a class="btn btn-primary" asp-action="Create">New Opportunity</a></div>
<div class="content-card"><form class="row g-2 mb-3"><div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search opportunity or customer" /></div><div class="col-md-3"><input name="stage" value="@ViewBag.Stage" class="form-control" placeholder="Stage" /></div><div class="col-md-3"><input name="status" value="@ViewBag.Status" class="form-control" placeholder="Status" /></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div></form>
<table class="table"><thead><tr><th>Name</th><th>Customer</th><th>Stage</th><th>Status</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Close</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.OpportunityName</td><td>@o.Customer?.CustomerName</td><td>@o.Stage</td><td>@o.Status</td><td>@o.Amount.ToString("C0")</td><td>@o.Probability%</td><td>@o.WeightedPipeline.ToString("C0")</td><td>@o.ExpectedCloseDate.ToShortDateString()</td><td class="text-end"><a asp-action="Details" asp-route-id="@o.OpportunityId">Details</a><a class="ms-2" asp-action="Edit" asp-route-id="@o.OpportunityId">Edit</a><form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline"><button class="btn btn-link btn-sm text-danger">Cancel</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty-state">No opportunities found.</div>}</div>
