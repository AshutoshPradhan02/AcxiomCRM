@model IEnumerable<AcxiomCRM.Web.Models.AuditLog>
@{ ViewData["Title"] = "Audit Log"; }
<div class="page-heading"><div><h1>Audit Log</h1><p class="text-muted">Append-only security and CRM activity history.</p></div></div>
<div class="content-card"><form class="row g-2 mb-3"><div class="col-md-2"><input name="module" value="@ViewBag.Module" class="form-control" placeholder="Module" /></div><div class="col-md-2"><input name="action" value="@ViewBag.Action" class="form-control" placeholder="Action" /></div><div class="col-md-3"><input name="from" value="@ViewBag.From" type="date" class="form-control" /></div><div class="col-md-3"><input name="to" value="@ViewBag.To" type="date" class="form-control" /></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div></form>
<table class="table table-sm"><thead><tr><th>Date</th><th>User</th><th>Module</th><th>Action</th><th>Record</th><th>Result</th><th>IP</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.CreatedDate.ToString("g")</td><td>@(a.User?.Email ?? a.UserId)</td><td>@a.EntityName</td><td>@a.Action</td><td>@a.RecordId</td><td>@a.Result</td><td>@a.IpAddress</td></tr>}</tbody></table></div>
