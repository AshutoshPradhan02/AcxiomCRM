@model IEnumerable<AcxiomCRM.Web.Models.CrmActivity>
@{ ViewData["Title"] = "Activities"; }
<div class="page-heading"><div><h1>Activities</h1><p class="text-muted">Calls, meetings, emails, and tasks.</p></div><a class="btn btn-primary" asp-action="Create">New Activity</a></div>
<div class="content-card"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Related</th><th>Status</th><th>Owner</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.ActivityDate.ToString("g")</td><td>@a.ActivityType</td><td>@a.Subject</td><td>@(a.Customer?.CustomerName ?? a.Lead?.LeadName)</td><td>@a.Status</td><td>@a.AssignedTo?.FullName</td><td><form asp-action="Complete" asp-route-id="@a.ActivityId" method="post"><button class="btn btn-sm btn-outline-primary">Complete</button></form></td></tr>}</tbody></table></div>
